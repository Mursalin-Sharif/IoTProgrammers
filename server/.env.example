# Server (Hostinger Node.js / VPS)
PORT=5000
NODE_ENV=production

# MongoDB Atlas (recommended for Hostinger) or local Mongo
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/iotprogrammers-portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/iotprogrammers-portfolio

# Optional MongoDB tuning (Atlas / Hostinger)
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=1
# MONGODB_SERVER_SELECTION_MS=8000
# CONTENT_CACHE_TTL_MS=60000
# UPLOAD_MAX_BYTES=8388608

# Public site URL (no trailing slash) — used for CORS when frontend is on another domain
# Same-origin deploy (Express serves React): leave empty or set your domain
CLIENT_ORIGIN=https://yourdomain.com

# Required: long random secret for admin JWT (min 32 chars). Never commit the real value.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# First-time admin seed only (existing hash is never overwritten on restart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
